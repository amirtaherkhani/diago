{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "replicaCount",
    "image",
    "serviceAccount",
    "mcp",
    "auth",
    "service",
    "ingress",
    "persistence"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "const": 1,
      "description": "Diago currently keeps MCP sessions in one process."
    },
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy", "tag", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string" },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[0-9a-f]{64})$"
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "required": ["create", "automount", "annotations", "name"],
      "properties": {
        "create": { "type": "boolean" },
        "automount": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      },
      "additionalProperties": false
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "mcp": {
      "type": "object",
      "required": ["allowedOrigins", "maxBodyBytes", "maxSessions", "sessionTtlMs"],
      "properties": {
        "allowedOrigins": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "maxBodyBytes": {
          "type": "integer",
          "minimum": 1024
        },
        "maxSessions": {
          "type": "integer",
          "minimum": 1
        },
        "sessionTtlMs": {
          "type": "integer",
          "minimum": 1000
        }
      },
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "required": ["existingSecret", "secretKey"],
      "properties": {
        "existingSecret": { "type": "string" },
        "secretKey": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "required": ["type", "port", "annotations"],
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": { "type": "object" }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "className", "annotations", "hosts", "tls"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host", "paths"],
            "properties": {
              "host": { "type": "string", "minLength": 1 },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["path", "pathType"],
                  "properties": {
                    "path": { "type": "string", "minLength": 1 },
                    "pathType": {
                      "enum": ["Exact", "Prefix", "ImplementationSpecific"]
                    }
                  },
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "additionalProperties": false
          }
        },
        "tls": { "type": "array" }
      },
      "additionalProperties": false
    },
    "persistence": {
      "type": "object",
      "required": [
        "enabled",
        "existingClaim",
        "accessModes",
        "size",
        "storageClass",
        "annotations"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "accessModes": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(Ei|Pi|Ti|Gi|Mi|Ki)?$"
        },
        "storageClass": { "type": "string" },
        "annotations": { "type": "object" }
      },
      "additionalProperties": false
    },
    "resources": { "type": "object" },
    "startupProbe": { "type": "object" },
    "livenessProbe": { "type": "object" },
    "readinessProbe": { "type": "object" },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" }
  },
  "additionalProperties": false
}
