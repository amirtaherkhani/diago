{
  "schema_version": 3,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Diago delivery lifecycle",
    "subtitle": "Artifact",
    "output": "lifecycle.html",
    "animation": "none"
  },
  "mainPath": [
    "pending",
    "delivered"
  ],
  "states": [
    {
      "id": "pending",
      "type": "start",
      "label": "Pending"
    },
    {
      "id": "delivered",
      "type": "success",
      "label": "Delivered"
    }
  ],
  "transitions": [
    {
      "from": "pending",
      "to": "delivered",
      "label": "Render succeeds"
    }
  ]
}
