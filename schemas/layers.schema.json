{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amirtaherkhani.github.io/diago/schemas/layers.schema.json",
  "title": "Diago Architecture Layers Diagram",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagram_type", "meta", "layers", "dependencies", "concerns", "gaps"],
  "properties": {
    "schema_version": { "const": 1 },
    "diagram_type": { "const": "layers" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "label", "status", "responsibilities"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "order": { "type": "integer", "minimum": 1 },
          "label": { "type": "string", "minLength": 1 },
          "status": { "$ref": "#/$defs/status" },
          "responsibilities": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "label", "status"],
        "properties": {
          "from": { "$ref": "#/$defs/id" },
          "to": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1 },
          "status": { "$ref": "#/$defs/status" }
        }
      }
    },
    "concerns": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "status", "appliesTo", "responsibility"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1 },
          "status": { "$ref": "#/$defs/status" },
          "appliesTo": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
          "responsibility": { "type": "string", "minLength": 1 }
        }
      }
    },
    "gaps": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "status", "layer"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1 },
          "status": { "$ref": "#/$defs/status" },
          "layer": { "$ref": "#/$defs/id" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "status": { "enum": ["verified", "proposed", "assumption"] }
  }
}
