{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amirtaherkhani.github.io/diago/schemas/fishbone.schema.json",
  "title": "Diago fishbone diagram",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "diagram_type",
    "meta",
    "effect",
    "categories"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "diagram_type": {
      "const": "fishbone"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "subtitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "\\S"
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "evidence"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 72,
          "pattern": "\\S"
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "causes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "\\S"
          },
          "causes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "status",
                "evidence"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 56,
                  "pattern": "\\S"
                },
                "status": {
                  "enum": [
                    "hypothesis",
                    "confirmed",
                    "ruled-out"
                  ]
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300,
                  "pattern": "\\S"
                }
              }
            }
          }
        }
      }
    }
  }
}
