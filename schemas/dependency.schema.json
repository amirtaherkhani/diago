{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amirtaherkhani.github.io/diago/schemas/dependency.schema.json",
  "title": "Diago dependency diagram",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "diagram_type",
    "meta",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "diagram_type": {
      "const": "dependency"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "subtitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "\\S"
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "kind",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48,
            "pattern": "\\S"
          },
          "kind": {
            "enum": [
              "module",
              "package",
              "service",
              "external"
            ]
          },
          "status": {
            "enum": [
              "verified",
              "proposed",
              "assumption"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "\\S"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 0,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "label",
          "status",
          "evidence"
        ],
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "to": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "verified",
              "proposed",
              "assumption"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "\\S"
          },
          "arrow": {
            "enum": [
              "dependency"
            ]
          }
        }
      }
    }
  }
}
