{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amirtaherkhani.github.io/diago/schemas/security-matrix.schema.json",
  "title": "Diago security-matrix diagram",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "diagram_type",
    "meta",
    "roles",
    "resources",
    "permissions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "diagram_type": {
      "const": "security-matrix"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "subtitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "\\S"
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "\\S"
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "\\S"
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 72,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "resource",
          "level",
          "value",
          "evidence"
        ],
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "resource": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "level": {
            "enum": [
              "admin",
              "write",
              "read",
              "none",
              "unknown"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24,
            "pattern": "\\S"
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
