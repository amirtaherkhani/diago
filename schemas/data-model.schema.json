{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amirtaherkhani.github.io/diago/schemas/data-model.schema.json",
  "title": "Diago Data Model Diagram",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagram_type", "meta", "entities", "relationships"],
  "properties": {
    "schema_version": { "const": 1 },
    "diagram_type": { "const": "data-model" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" }
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "status", "fields"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1 },
          "status": { "$ref": "#/$defs/status" },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "type": { "type": "string", "minLength": 1 },
                "key": { "enum": ["primary", "foreign", "unique"] },
                "required": { "type": "boolean" }
              }
            }
          },
          "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "relationships": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to", "label", "fromCardinality", "toCardinality", "status"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "from": { "$ref": "#/$defs/id" },
          "to": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1 },
          "fromCardinality": { "$ref": "#/$defs/cardinality" },
          "toCardinality": { "$ref": "#/$defs/cardinality" },
          "status": { "$ref": "#/$defs/status" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "status": { "enum": ["verified", "proposed", "assumption"] },
    "cardinality": { "enum": ["1", "0..1", "*", "0..*", "1..*"] }
  }
}
